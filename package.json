{
  "name": "microservices-nest.js",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:full": "rimraf --glob \"**/{node_modules,package-lock.json,dist}\"",
    "build": "npx turbo run build",
    "test": "npx turbo run test",
    "prettier:check": "npx turbo run prettier:check",
    "prettier": "turbo run prettier",
    "lint:check": "npx turbo run lint:check",
    "lint": "npx turbo run lint",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages"
  ],
  "overrides": {
    "glob": "^10.3.12",
    "inflight": "npm:lru-cache@^7.18.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript": "^5.6.2",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.2"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
